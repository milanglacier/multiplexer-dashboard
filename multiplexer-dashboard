class Plan:
    """The commands of an action. The steps run in order and the first
    failure stops them. Outside a multiplexer, attach is the client that
    then replaces the dashboard, started in cwd, and helper is a command
    started in the background just before it."""

    steps: list[list[str]] = field(default_factory=list)
