# ---------------------------------------------------------------- terminal


class Event(NamedTuple):
    """A key press, named as "j", "enter" or "alt+up", a mouse press or
    release at a 0-based cell, or the terminal gaining ("in") or losing
    ("out") focus."""

    kind: str
    key: str = ""
    button: int = 0
    x: int = 0
    y: int = 0


MOUSE_RE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
# A late reply to a terminal query, which is ignored.
OSC_RE = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
# A lone ESC is the Escape key. ESC followed by [ or O starts a sequence, and
# ESC followed by any other key is Alt with that key.
KEY_SEQ_RE = re.compile(
    r"\x1b?\x1b\[[0-9;]*[A-Za-z~]|\x1bO[A-Za-z]|\x1b[\s\S]",
)
# Modified arrows and Home/End, such as ESC [ 1 ; 3 A for Alt+Up.
MOD_KEY_RE = re.compile(r"\x1b\[1;(\d+)([A-DHF])")
KEY_NAMES = {
    "\x1b[A": "up",
    "\x1bOA": "up",
    "\x1b[B": "down",
    "\x1bOB": "down",
    "\x1b[C": "right",
    "\x1bOC": "right",
    "\x1b[D": "left",
    "\x1bOD": "left",
    "\x1b[H": "home",
    "\x1bOH": "home",
    "\x1b[1~": "home",
    "\x1b[7~": "home",
    "\x1b[F": "end",
    "\x1bOF": "end",
    "\x1b[4~": "end",
    "\x1b[8~": "end",
    "\x1b[5~": "pgup",
    "\x1b[6~": "pgdown",
    "\x1b[3~": "delete",
    "\x1b[Z": "shift+tab",
    "\t": "tab",
    "\r": "enter",
    "\n": "enter",
    "\x7f": "backspace",
    "\x08": "backspace",
    "\x1b": "esc",
    "\x03": "ctrl+c",
    "\x0c": "ctrl+l",
    "\x15": "ctrl+u",
    "\x17": "ctrl+w",
    "\x0e": "down",
    "\x10": "up",
}
ARROWS = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end"}
# Focus reports, sent while focus reporting (mode 1004) is on.
FOCUS_SEQS = {"\x1b[I": "in", "\x1b[O": "out"}


def key_name(seq: str) -> str:
    if seq in KEY_NAMES:
        return KEY_NAMES[seq]
    m = MOD_KEY_RE.fullmatch(seq)
    if m:
        # The xterm modifier parameter is 1 + shift (1) + alt (2) + ctrl (4).
        bits = int(m[1]) - 1
        mods = [n for b, n in ((4, "ctrl"), (2, "alt"), (1, "shift")) if bits & b]
        return "+".join(mods + [ARROWS[m[2]]])
    if seq.startswith("\x1b\x1b["):
        return "alt+" + key_name(seq[1:])
    if len(seq) == 2 and seq[0] == "\x1b":
        return "alt+" + KEY_NAMES.get(seq[1], seq[1])
    return seq


def parse_input(data: str) -> list[Event]:
    """Turns the text of one read from the terminal into events. Replies to
    terminal queries are dropped."""
    events: list[Event] = []
    i = 0
    while i < len(data):
        m = MOUSE_RE.match(data, i)
        if m:
            # Drop the shift, alt and ctrl bits.
            button = int(m[1]) & ~0b11100
            kind = "mouse" if m[4] == "M" else "release"
            events.append(Event(kind, button=button, x=int(m[2]) - 1, y=int(m[3]) - 1))
            i = m.end()
            continue
        m = OSC_RE.match(data, i)
        if m:
            i = m.end()
            continue
        m = KEY_SEQ_RE.match(data, i)
        seq = m.group() if m else data[i]
        i = m.end() if m else i + 1
        if seq in FOCUS_SEQS:
            events.append(Event("focus", FOCUS_SEQS[seq]))
        else:
            events.append(Event("key", key_name(seq)))
    return events


def luminance_is_dark(reply: bytes) -> bool | None:
    """Reads an OSC 11 reply. None when it holds no color."""
    m = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", reply)
    if not m:
        return None
    r, g, b = (int(x, 16) / (16 ** len(x) - 1) for x in m.groups())
    return 0.2126 * r + 0.7152 * g + 0.0722 * b < 0.5


class Term:
    """Raw mode, the alternate screen, mouse reporting, focus reporting when
    asked for, and a renderer that rewrites only the lines that changed, all
    on /dev/tty."""

    def __init__(self, wake_fd: int, focus_events: bool = False) -> None:
        self.fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        self.saved = termios.tcgetattr(self.fd)
        self.wake_fd = wake_fd
        self.focus_events = focus_events
        self.prev: list[str] = []
        self.decoder = codecs.getincrementaldecoder("utf-8")("replace")
        self.resized = False

    def write(self, s: str) -> None:
        data = s.encode()
        while data:
            n = os.write(self.fd, data)
            data = data[n:]

    def __enter__(self) -> None:
        tty.setraw(self.fd)
        # Alternate screen, hidden cursor, button and wheel mouse in SGR form,
        # and focus reports.
        self.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1006h")
        if self.focus_events:
            self.write("\x1b[?1004h")

    def __exit__(self, *exc: object) -> None:
        # Each step is tried even when an earlier one fails, such as when
        # the terminal has gone away.
        try:
            focus = "\x1b[?1004l" if self.focus_events else ""
            self.write(focus + "\x1b[?1006l\x1b[?1000l\x1b[0m\x1b[?25h\x1b[?1049l")
        except OSError:
            pass
        try:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)
        except (OSError, termios.error):
            pass
        os.close(self.fd)

    def size(self) -> tuple[int, int]:
        sz = os.get_terminal_size(self.fd)
        return sz.columns, sz.lines

    def background_is_dark(self) -> bool | None:
        """Asks the terminal for its background color (OSC 11) and waits up
        to 250 ms. None when the terminal does not answer."""
        self.write("\x1b]11;?\x1b\\")
        buf, deadline = b"", time.monotonic() + 0.25
        while time.monotonic() < deadline:
            r, _, _ = select.select(
                [self.fd], [], [], max(0.0, deadline - time.monotonic())
            )
            if not r:
                break
            buf += os.read(self.fd, 256)
            if buf.endswith((b"\x07", b"\x1b\\")):
                break
        return luminance_is_dark(buf)

    def invalidate(self) -> None:
        self.prev = []

    def draw(self, lines: list[str]) -> None:
        if self.resized:
            self.resized = False
            self.prev = []
        # Synchronized output keeps the terminal from showing half a frame.
        out = ["\x1b[?2026h"]
        if len(self.prev) != len(lines):
            out.append("\x1b[0m\x1b[2J")
            self.prev = []
        for y, line in enumerate(lines):
            if y >= len(self.prev) or self.prev[y] != line:
                out.append(f"\x1b[{y + 1};1H{line}{RESET}")
        out.append("\x1b[?2026l")
        if len(out) > 2:
            self.write("".join(out))
        self.prev = lines

    def events(self, timeout: float) -> list[Event]:
        """Waits up to timeout seconds for input or a wake-up, and returns
        the input's events."""
        r, _, _ = select.select([self.fd, self.wake_fd], [], [], max(0.0, timeout))
        if self.fd not in r:
            return []
        return parse_input(self.decoder.decode(os.read(self.fd, 4096)))


