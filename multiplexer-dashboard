def hex_rgb(h: str) -> RGB:
    return (int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16))


def mix(a: RGB, b: RGB, t: float) -> RGB:
    return (
        round(a[0] + (b[0] - a[0]) * t),
        round(a[1] + (b[1] - a[1]) * t),
        round(a[2] + (b[2] - a[2]) * t),
    )


class Theme:
    base: RGB
    surface: RGB
    overlay: RGB
    muted: RGB
    subtle: RGB
    text: RGB
    love: RGB
    gold: RGB
    rose: RGB
    pine: RGB
    foam: RGB
    iris: RGB
    hl_low: RGB
    hl_med: RGB
    hl_high: RGB

    def __init__(self, dark: bool, dim: float = 0.0) -> None:
        colors = {
            k: hex_rgb(v) for k, v in PALETTES["dark" if dark else "light"].items()
        }
        if dim:
            # Behind a dialog, every color fades toward the background.
            colors = {
                k: v if k == "base" else mix(v, colors["base"], dim)
                for k, v in colors.items()
            }
        for k, v in colors.items():
            setattr(self, k, v)
        self.dark = dark
        self.dimmed = dim > 0

    def mux(self, name: str) -> RGB:
        return {"zellij": self.foam, "herdr": self.iris, "tmux": self.rose}.get(
            name, self.text
        )

    def agent(self, name: str) -> RGB:
        colors = {
            "claude": self.gold,
            "codex": self.foam,
            "opencode": self.iris,
            "pi": self.rose,
        }
        return colors.get(name, self.pine)


RESET = "\x1b[0m"
_DEFAULT: Any = object()


class Canvas:
    """Settings that every paint call reads: the theme and whether the app
    paints its own background."""

    theme = Theme(True)
    paint_bg = True


def sgr(
    fg: RGB | None = None,
    bg: RGB | None = None,
    bold: bool = False,
    dim: bool = False,
    italic: bool = False,
    underline: bool = False,
) -> str:
    codes = []
    if bold:
        codes.append("1")
    if dim:
        codes.append("2")
    if italic:
        codes.append("3")
    if underline:
        codes.append("4")
    if fg is not None:
        codes.append("38;2;{};{};{}".format(*fg))
    if bg is not None:
        codes.append("48;2;{};{};{}".format(*bg))
    return "\x1b[" + ";".join(codes) + "m" if codes else ""


def paint(text: str, fg: RGB | None = None, bg: Any = _DEFAULT, **kw: bool) -> str:
    if not text:
        return ""
    if bg is _DEFAULT:
        bg = Canvas.theme.base if Canvas.paint_bg else None
    pre = sgr(fg, bg, **kw)
    return pre + text + RESET if pre else text


class Pen:
    """Paints segments on one background, such as a selected row's."""

    def __init__(self, bg: Any = _DEFAULT) -> None:
        self.bg = bg

    def __call__(self, text: str, fg: RGB | None = None, **kw: Any) -> str:
        kw.setdefault("bg", self.bg)
        return paint(text, fg, **kw)


ANSI_RE = re.compile(r"\x1b\[[0-9;:?<=>]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")


def cell_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def width(s: str) -> int:
    return sum(cell_width(c) for c in ANSI_RE.sub("", s))


def cut(s: str, start: int, end: int | None = None) -> str:
    """The cells start..end of a painted string, with the colors in effect at
    start carried over. A wide character that does not fit is left out."""
    out: list[str] = []
    active, n, i, started = "", 0, 0, False
    while i < len(s):
        m = ANSI_RE.match(s, i)
        if m:
            seq = m.group()
            i = m.end()
            if seq.endswith("m"):
                active = "" if seq in (RESET, "\x1b[m") else active + seq
                if started:
                    out.append(seq)
            continue
        cw = cell_width(s[i])
        if end is not None and n + cw > end:
            break
        if n >= start:
            if not started:
                out.append(active)
                started = True
            out.append(s[i])
        n += cw
        i += 1
    return "".join(out) + RESET


def fit(s: str, w: int, pen: Pen | None = None) -> str:
    """Truncates a painted string with "…", or pads it, to exactly w cells."""
    pen = pen or Pen()
    if w <= 0:
        return ""
    if width(s) > w:
        s = cut(s, 0, w - 1) + pen("…", Canvas.theme.muted)
    return s + pen(" " * (w - width(s)))


def lr(left: str, right: str, w: int, pen: Pen | None = None) -> str:
    """Left-aligned and right-aligned text on one line of w cells."""
    rw = width(right)
    return fit(right, w, pen) if rw >= w else fit(left, w - rw, pen) + right


def overlay(base: str, x: int, s: str) -> str:
    return cut(base, 0, x) + s + cut(base, x + width(s))


def gradient(text: str, c1: RGB, c2: RGB, fg: RGB) -> str:
    n = max(1, len(text) - 1)
    return "".join(
        paint(ch, fg, mix(c1, c2, i / n), bold=True) for i, ch in enumerate(text)
    )


def flow(pieces: Sequence[str], w: int, sep: str = "") -> list[str]:
    """Painted pieces on lines of at most w cells, joined by sep. A piece
    that does not fit starts a new line, and a piece wider than w gets a
    line of its own."""
    lines: list[str] = []
    line = ""
    for p in pieces:
        if line and width(line) + width(sep) + width(p) > w:
            lines.append(line)
            line = p
        else:
            line = line + sep + p if line else p
    if line:
        lines.append(line)
    return lines


def plural(n: int, unit: str) -> str:
    return f"{n} {unit}" + ("" if n == 1 else "s")


def format_age(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


# Escape sequences in captured pane text: CSI, OSC, DCS and friends, and
# two-character escapes.
CAPTURE_SEQ_RE = re.compile(
    r"\x1b\[[0-9;:<=>?]*[ -/]*[@-~]"
    r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?"
    r"|\x1b[PX^_][^\x1b]*(?:\x1b\\)?"
    r"|\x1b[ -/]*[0-~]?"
)
SGR_RE = re.compile(r"\x1b\[([0-9;:]*)m")


def sanitize_capture(text: str) -> list[str]:
    """Captured pane text as lines that keep their SGR sequences (colors and
    styles) and nothing else: other escape sequences and control characters
    are dropped, tabs are expanded, and trailing blank lines are removed."""
    lines: list[str] = []
    for raw_line in text.replace("\r\n", "\n").split("\n"):
        out: list[str] = []
        col, i = 0, 0
        while i < len(raw_line):
            ch = raw_line[i]
            if ch == "\x1b":
                m = CAPTURE_SEQ_RE.match(raw_line, i)
                if m:
                    if SGR_RE.fullmatch(m.group()):
                        out.append(m.group())
                    i = m.end()
                    continue
                i += 1
                continue
            i += 1
            if ch == "\t":
                n = 8 - col % 8
                out.append(" " * n)
                col += n
            elif ord(ch) < 32 or 0x7F <= ord(ch) < 0xA0:
                continue
            else:
                out.append(ch)
                col += cell_width(ch)
        lines.append("".join(out))
    while lines and not ANSI_RE.sub("", lines[-1]).strip():
        lines.pop()
    return lines


def resets_background(params: str) -> bool:
    """Whether an SGR parameter list resets the background or the dimming:
    0 (or nothing), 22 or 49. Colors given as 38;5;N or 38;2;R;G;B are
    skipped, so that a 0 inside a color does not count."""
    if params in ("", "0"):
        return True
    parts = params.split(";")
    i = 0
    while i < len(parts):
        p = parts[i].split(":")[0]
        if p in ("38", "48", "58") and ":" not in parts[i]:
            if i + 1 < len(parts) and parts[i + 1] == "5":
                i += 3
                continue
            if i + 1 < len(parts) and parts[i + 1] == "2":
                i += 5
                continue
        if p in ("", "0", "22", "49"):
            return True
        i += 1
    return False


def raw(line: str) -> str:
    """A captured pane line on the app's background, faded when the screen
    is dimmed behind a dialog."""
    t = Canvas.theme
    pre = (sgr(bg=t.base) if Canvas.paint_bg else "") + ("\x1b[2m" if t.dimmed else "")
    if not pre:
        return line + RESET
    body = SGR_RE.sub(
        lambda m: m.group() + pre if resets_background(m[1]) else m.group(), line
    )
    return pre + body + RESET


# ---------------------------------------------------------------- commands


class Result(NamedTuple):
    code: int
    out: str
    err: str


Runner = Callable[[Sequence[str]], Result]


def run_command(args: Sequence[str], timeout: float = 5.0) -> Result:
    """Runs a command without a shell and returns its status and output."""
    try:
        p = subprocess.run(
            list(args),
            check=False,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        return Result(127, "", f"{args[0]}: command not found")
    except subprocess.TimeoutExpired:
        return Result(124, "", f"{args[0]}: no answer after {timeout:g} seconds")
    except OSError as e:
        return Result(126, "", f"{args[0]}: {e.strerror}")
    return Result(
        p.returncode,
        p.stdout.decode("utf-8", "replace"),
        p.stderr.decode("utf-8", "replace"),
    )


def herdr_error(text: str) -> tuple[str, str] | None:
    """The code and message of a herdr error, which herdr prints as JSON."""
    try:
        data = json.loads(text)
    except ValueError:
        return None
    err = data.get("error") if isinstance(data, dict) else None
    if not isinstance(err, dict):
        return None
    return str(err.get("code", "")), str(err.get("message", ""))


def error_text(r: Result) -> str:
    """One line that says why a command failed."""
    text = r.err.strip() or r.out.strip()
    herdr = herdr_error(text)
    if herdr:
        return (
            "server not running"
            if herdr[0] == "server_not_running"
            else herdr[1] or herdr[0]
        )
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    return lines[0] if lines else f"exit status {r.code}"


def run_parallel(calls: Sequence[Callable[[], Any]]) -> list[Any]:
    """Runs the calls in threads and returns their results in order."""
    results: list[Any] = [None] * len(calls)

    def work(i: int, call: Callable[[], Any]) -> None:
        results[i] = call()

    threads = [
        threading.Thread(target=work, args=(i, c), daemon=True)
        for i, c in enumerate(calls)
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return results


