class Inbox:
    """Results of work on other threads. A thread puts its result in the
    queue and writes a byte to a pipe, which wakes the main loop."""

    def __init__(self) -> None:
        self.queue: queue.Queue[tuple[str, Any, Any]] = queue.Queue()
        self.read_fd, self.write_fd = os.pipe()
        os.set_blocking(self.read_fd, False)
        os.set_blocking(self.write_fd, False)

    def wake(self) -> None:
        try:
            os.write(self.write_fd, b"x")
        except OSError:
            pass

    def spawn(self, kind: str, key: Any, work: Callable[[], Any]) -> None:
        def target() -> None:
            try:
                value = work()
            except Exception as e:  # noqa: BLE001 - shown in the dashboard
                value = e
            self.queue.put((kind, key, value))
            self.wake()

        threading.Thread(target=target, daemon=True).start()

    def drain(self) -> list[tuple[str, Any, Any]]:
        try:
            while os.read(self.read_fd, 4096):
                pass
        except OSError:
            pass
        out = []
        while True:
            try:
                out.append(self.queue.get_nowait())
            except queue.Empty:
                return out


@dataclass
class Options:
    client: str | None = None
    directory: str | None = None
    dark: bool = True
    paint_bg: bool = True
    # Show only the lists, and inside a multiplexer stay open after a
    # switch.
    sidebar: bool = False


class App:
    """The dashboard's state and its reaction to input and loaded data."""

    def __init__(
        self,
        ctx: Context,
        options: Options,
        runner: Runner = run_command,
        env: Mapping[str, str] = os.environ,
        inbox: Inbox | None = None,
    ) -> None:
        self.ctx = ctx
        self.options = options
        self.runner = runner
        self.env = env
        self.inbox = inbox
        self.backends = {
            m: BACKENDS[m](runner, env, options.client) for m in ctx.listed
        }
        self.groups = {m: Group(m, loading=True) for m in ctx.listed}
        self.focus = SESSIONS
        self.cursor = [0, 0]
        self.offset = [0, 0]
        # The item to put the cursor on when it appears, such as a renamed
        # session.
        self.wanted: list[tuple[str, ...] | None] = [None, None]
        # Whether the user has moved a list's cursor. Until then, the cursor
        # stays on the first row while the multiplexers answer.
        self.touched = [False, False]
        self.filter = ""
        self.mode: str | None = None  # filter, new, rename, kill or help
        self.input = ""
        self.target: Row | None = None
        self.new_mux = ctx.listed[0] if ctx.listed else ""
        self.new_dirs: dict[str, tuple[str, str]] = {}
        self.toast: tuple[str, bool, float] | None = None
        self.hits: list[Hit] = []
        self.result: Exit | None = None
        self.redraw_all = False
        self.loading: dict[str, bool] = {m: False for m in ctx.listed}
        self.loaded_at: dict[str, float] = {m: float("-inf") for m in ctx.listed}
        self.generation: dict[str, int] = {m: 0 for m in ctx.listed}
        self.previews: dict[tuple[str, ...], Preview] = {}
        self.capturing: set[tuple[str, ...]] = set()
        self.selection: tuple[str, ...] | None = None
        self.selection_since = 0.0
        # In a sidebar inside a multiplexer, the dashboard stays open after
        # a switch, and Escape runs the back command of the first
        # multiplexer it runs in, in the order zellij, tmux, herdr, that has
        # one.
        self.stays_open = options.sidebar and bool(ctx.inside)
        enclosing = [
            self.backends[m]
            for m in MULTIPLEXERS
            if m in self.backends and m in ctx.inside
        ]
        self.back_command = next(
            (cmd for cmd in (b.back() for b in enclosing) if cmd), None
        )
        # Whether the pane has focus and whether it is on screen. A focus
        # report, a key press or a mouse press gives it focus. The terminal
        # sends focus reports only in sidebar mode, so focus_reported stays
        # False elsewhere and in terminals that never send them.
        self.focused = False
        self.focus_reported = False
        # Whether focus came in after the last key or mouse press. The click
        # that gives a pane focus only selects a row, even the selected one.
        self.just_focused = False
        self.visible = True
        self.checks = (
            [b for b in enclosing if b.checks_visibility] if self.stays_open else []
        )
        self.checking = False
        self.next_check = 0.0
        self.view = View(self)

    # ------------------------------------------------------------ queries

    def ordered_groups(self) -> list[Group]:
        return [self.groups[m] for m in self.ctx.listed]

    def rows(self, which: int) -> list[Row]:
        return build_rows(self.ordered_groups(), which, self.filter)

    def items(self, which: int) -> list[Row]:
        return items_of(self.rows(which))

    def selected(self, which: int | None = None) -> Row | None:
        w = self.focus if which is None else which
        items = self.items(w)
        if not items:
            return None
        return items[max(0, min(self.cursor[w], len(items) - 1))]

    def inside(self, mux: str) -> bool:
        return mux in self.ctx.inside

    def current_session(self, mux: str) -> Session | None:
        return next((s for s in self.groups[mux].sessions if s.current), None)

    def agents_of(self, s: Session) -> list[Agent]:
        return [a for a in self.groups[s.mux].agents if a.session_key == s.key]

    def clamp(self) -> None:
        for w in (SESSIONS, AGENTS):
            self.cursor[w] = max(0, min(self.cursor[w], len(self.items(w)) - 1))

    # ------------------------------------------------------------ loading

    def start_load(self, mux: str) -> None:
        if self.loading[mux] or self.inbox is None:
            return
        self.loading[mux] = True
        backend, inside = self.backends[mux], self.inside(mux)
        self.inbox.spawn("load", mux, lambda: backend.load(inside))

    def refresh(self) -> None:
        for mux in self.ctx.listed:
            self.start_load(mux)

    def start_check(self) -> None:
        """Asks on another thread whether the pane is on screen: it is when
        no multiplexer it runs in says otherwise."""
        if self.checking or self.inbox is None:
            return
        self.checking = True
        checks = self.checks
        self.inbox.spawn(
            "visible", None, lambda: all(b.visible() is not False for b in checks)
        )

    def receive(self, kind: str, key: Any, value: Any, now: float) -> None:
        if kind == "load":
            self.loading[key] = False
            self.loaded_at[key] = now
            group = (
                value
                if isinstance(value, Group)
                else Group(key, error=f"failed: {value}")
            )
            self.set_group(group)
        elif kind == "preview":
            self.capturing.discard(key)
            generation, result = value if isinstance(value, tuple) else (0, value)
            if isinstance(result, Exception):
                self.previews[key] = Preview(generation, [], str(result))
            elif result.code != 0:
                self.previews[key] = Preview(generation, [], error_text(result))
            else:
                self.previews[key] = Preview(generation, sanitize_capture(result.out))
        elif kind == "visible":
            self.checking = False
            self.next_check = now + VISIBILITY_CHECK_SECONDS
            was, self.visible = self.visible, value is not False
            if not self.visible:
                # A hidden pane has no focus, also in a terminal that sends
                # no focus reports.
                self.focused = False
            elif not was:
                self.refresh()

    def set_group(self, group: Group) -> None:
        """Replaces a multiplexer's data and keeps each cursor on the same
        session or agent when it still exists."""
        before = [self.selected(w) for w in (SESSIONS, AGENTS)]
        keys = [item_key(r) if r else None for r in before]
        self.groups[group.mux] = group
        self.generation[group.mux] += 1
        for w in (SESSIONS, AGENTS):
            items = [item_key(r) for r in self.items(w)]
            want, had = self.wanted[w], keys[w]
            if want and want in items:
                self.cursor[w] = items.index(want)
                self.wanted[w] = None
            elif had and had in items and self.touched[w]:
                self.cursor[w] = items.index(had)
        self.clamp()

    # ------------------------------------------------------------ timing

    def refresh_period(self) -> float | None:
        """The time between full loads: 2 seconds, and in sidebar mode 5
        seconds while the pane is on screen without focus and none while
        it is hidden."""
        if not self.options.sidebar or self.focused:
            return REFRESH_SECONDS
        return UNFOCUSED_REFRESH_SECONDS if self.visible else None

    def next_load(self, mux: str) -> float | None:
        """When the next full load of a multiplexer is due, or None."""
        period = self.refresh_period()
        return None if period is None else self.loaded_at[mux] + period

    def wants_check(self) -> bool:
        """Whether the visibility checks run: while the pane has no focus,
        and always in a terminal that sends no focus reports, where only
        a check can take the focus away."""
        return bool(self.checks) and not (self.focused and self.focus_reported)

    def tick(self, now: float) -> None:
        for mux in self.ctx.listed:
            due = self.next_load(mux)
            if not self.loading[mux] and due is not None and now >= due:
                self.start_load(mux)
        if self.wants_check() and now >= self.next_check:
            self.start_check()
        if self.toast and now > self.toast[2]:
            self.toast = None
        if self.options.sidebar:
            return
        row = self.selected()
        key = item_key(row) if row else None
        if key != self.selection:
            self.selection, self.selection_since = key, now
        elif row and key and now - self.selection_since >= PREVIEW_DELAY:
            self.maybe_capture(row, key)

    def timeout(self, now: float) -> float:
        """How long the main loop may wait for input. Input, resizes and
        loaded data wake it at once, so the bound of 0.5 seconds only keeps
        it lively. In sidebar mode the bound applies only while the pane
        has focus, so that a pane without focus wakes only for its next
        load or visibility check."""
        waits = []
        if not self.options.sidebar or self.focused:
            waits.append(0.5)
        for m in self.ctx.listed:
            due = self.next_load(m)
            if not self.loading[m] and due is not None:
                waits.append(due - now)
        if self.wants_check() and not self.checking:
            waits.append(self.next_check - now)
        preview_due = self.selection_since + PREVIEW_DELAY
        if self.selection and now < preview_due:
            waits.append(preview_due - now)
        if self.toast:
            waits.append(self.toast[2] - now)
        # With nothing due, as in a hidden pane while its check runs, only
        # input or another thread's result wakes the loop.
        return max(0.01, min(waits, default=60.0))

    # ------------------------------------------------------------ preview

    def preview_target(self, row: Row) -> tuple[str, Session | None] | None:
        """The pane to capture for a row, and the session that the capture
        needs: the row's own session, or a zellij agent's session."""
        if row.agent:
            # zellij needs the session to find the pane.
            zellij = row.mux == "zellij"
            return row.agent.pane, Session(
                "zellij", row.agent.session
            ) if zellij else None
        if row.session and not row.session.exited and row.session.pane:
            return row.session.pane, row.session
        return None

    def maybe_capture(self, row: Row, key: tuple[str, ...]) -> None:
        if self.inbox is None or key in self.capturing:
            return
        generation = self.generation[row.mux]
        have = self.previews.get(key)
        if have and have.generation == generation:
            return
        target = self.preview_target(row)
        if not target:
            return
        backend = self.backends[row.mux]
        pane, session = target
        self.capturing.add(key)
        self.inbox.spawn(
            "preview", key, lambda: (generation, backend.capture(pane, session))
        )

    # ------------------------------------------------------------ actions

    def say(self, text: str, warn: bool = False, seconds: float = 5.0) -> None:
        self.toast = (text, warn, time.monotonic() + seconds)

    def run_steps(self, plan: Plan) -> bool:
        """Runs a plan's steps in order. The first failure stops them and
        shows its error."""
        for step in plan.steps:
            r = self.runner(step)
            if r.code != 0:
                self.say(error_text(r), warn=True)
                return False
        return True

    def execute(self, plan: Plan, done: str) -> None:
        """Runs a plan's steps. On success the dashboard exits, or hands over
        to the attaching client. A sidebar inside a multiplexer stays open
        instead: it says what it did (done) and loads the lists again."""
        if not self.run_steps(plan):
            return
        if self.stays_open and not plan.attach:
            # Focus has moved to another pane or session.
            self.focused = False
            self.say(done)
            self.refresh()
        else:
            self.result = Exit(0, plan if plan.attach else None)

    def back(self) -> None:
        """Leaves the current session as it is: a sidebar gives focus back
        to the last pane, and the dashboard elsewhere closes."""
        if not self.stays_open:
            self.result = Exit(0)
        elif self.back_command:
            r = self.runner(self.back_command)
            if r.code != 0:
                self.say(error_text(r), warn=True)
            else:
                self.focused = False

    def switch(self, row: Row) -> None:
        mux, inside = row.mux, self.inside(row.mux)
        backend = self.backends[mux]
        if row.session:
            if row.session.current and inside:
                self.back()
                return
            done = f"Switched to {row.session.name}."
            self.execute(backend.switch_session(row.session, inside), done)
        elif row.agent:
            current = self.current_session(mux)
            plan = backend.switch_agent(
                row.agent, inside, current.name if current else None
            )
            # The helper moves the session's first client, which is the
            # attaching one only when the session has no other client.
            if (
                plan.helper
                and isinstance(backend, Zellij)
                and backend.has_clients(row.agent.session)
            ):
                plan.helper = None
            self.execute(plan, f"Switched to {row.agent.name} in {row.agent.session}.")

    def new_session_dir(self, mux: str) -> tuple[str, str]:
        """The directory and automatic name of a new session in mux."""
        if mux not in self.new_dirs:
            directory = (
                self.options.directory
                or self.backends[mux].default_dir(self.inside(mux))
                or os.getcwd()
            )
            directory = os.path.abspath(os.path.expanduser(directory))
            home = self.env.get("HOME") or os.path.expanduser("~")
            name = sanitize_name(
                dir_label(directory, home, git_root(self.runner, directory))
            )
            self.new_dirs[mux] = (directory, name)
        return self.new_dirs[mux]

    def create(self, mux: str, typed: str) -> None:
        directory, automatic = self.new_session_dir(mux)
        name = sanitize_name(typed.strip()) or automatic
        backend = self.backends[mux]
        inside = self.inside(mux)
        if isinstance(backend, Herdr) and not inside:
            err = backend.start_server()
            if err:
                self.say(err, warn=True)
                return
        # Ask again, so that a session made since the last refresh counts.
        group = backend.load(inside)
        if group.error:
            self.say(group.error, warn=True)
            return
        existing = next((s for s in group.sessions if s.name == name), None)
        if existing:
            if existing.current and inside:
                self.back()
                return
            self.execute(
                backend.switch_session(existing, inside), f"Switched to {name}."
            )
        else:
            self.execute(backend.create(name, directory, inside), f"Created {name}.")

    def rename(self, s: Session, typed: str) -> None:
        new = sanitize_name(typed.strip())
        if not new or new == s.name:
            return
        if self.run_steps(self.backends[s.mux].rename(s, new)):
            if s.mux == "zellij":
                self.wanted[SESSIONS] = ("session", "zellij", new)
            s.name = new
            self.say(f"Renamed to {new}.")
            self.start_load(s.mux)

    def kill(self, s: Session) -> None:
        if self.run_steps(self.backends[s.mux].kill(s)):
            group = self.groups[s.mux]
            group.sessions = [x for x in group.sessions if x.key != s.key]
            group.agents = [a for a in group.agents if a.session_key != s.key]
            self.clamp()
            self.say(f"{'Deleted' if s.exited else 'Killed'} {s.name}.")
            self.start_load(s.mux)

    # ------------------------------------------------------------ input

    def handle(self, ev: Event) -> None:
        if ev.kind == "focus":
            self.focus_reported = True
            self.focused = self.just_focused = ev.key == "in"
            if self.focused:
                self.visible = True
                self.refresh()
            return
        if ev.kind == "release":
            # zellij keeps the press that gives a pane focus and sends only
            # the release, so a release right after focus comes in counts
            # as the click. Every other release is ignored.
            if not self.just_focused:
                return
            ev = ev._replace(kind="mouse")
        # A key or a mouse press means the user is in the pane, also in a
        # terminal that sends no focus reports.
        self.focused = self.visible = True
        before = list(self.cursor)
        self.dispatch(ev)
        self.just_focused = False
        for w in (SESSIONS, AGENTS):
            self.touched[w] = self.touched[w] or self.cursor[w] != before[w]

    def dispatch(self, ev: Event) -> None:
        if ev.kind == "mouse":
            self.mouse(ev.button, ev.x, ev.y)
            return
        k = ev.key
        if k == "ctrl+c":
            self.result = Exit(0)
            return
        if self.mode:
            self.dialog_key(k)
            return
        self.list_key(k)

    def list_key(self, k: str) -> None:
        w = self.focus
        n = len(self.items(w))
        if k in ("j", "down"):
            self.cursor[w] = min(n - 1, self.cursor[w] + 1)
        elif k in ("k", "up"):
            self.cursor[w] = max(0, self.cursor[w] - 1)
        elif k in ("alt+j", "alt+down", "alt+k", "alt+up"):
            self.cursor[w] = jump_group(
                self.items(w), self.cursor[w], 1 if k in ("alt+j", "alt+down") else -1
            )
        elif k in ("g", "home"):
            self.cursor[w] = 0
        elif k in ("G", "end"):
            self.cursor[w] = max(0, n - 1)
        elif k == "tab":
            self.focus = AGENTS if w == SESSIONS else SESSIONS
        elif k == "enter":
            row = self.selected()
            if row:
                self.switch(row)
        elif k == "/":
            self.mode, self.input = "filter", self.filter
        elif k == "?":
            self.mode = "help"
        elif k == "n":
            row = self.selected()
            self.new_mux = row.mux if row else self.ctx.listed[0]
            self.mode, self.input = "new", ""
        elif k in ("r", "x"):
            self.session_dialog(k)
        elif k == "ctrl+l":
            self.redraw_all = True
            self.refresh()
        elif k == "q":
            self.result = Exit(0)
        elif k == "esc":
            if self.filter:
                self.filter = ""
            else:
                self.back()

    def session_dialog(self, k: str) -> None:
        row = self.selected()
        if not row or not row.session:
            self.say(
                "Rename and kill work on sessions. Press Tab to go to the Sessions list.",
                warn=True,
            )
        elif k == "r" and row.session.exited:
            self.say("An exited zellij session cannot be renamed.", warn=True)
        else:
            self.target = row
            self.mode = "rename" if k == "r" else "kill"
            self.input = row.session.name if k == "r" else ""

    def dialog_key(self, k: str) -> None:
        mode = self.mode
        if mode == "help":
            self.mode = None
            return
        if mode == "kill":
            self.mode = None
            if k in ("y", "Y", "enter") and self.target and self.target.session:
                self.kill(self.target.session)
            return
        if k == "esc":
            if mode == "filter":
                self.filter = ""
            self.mode, self.input = None, ""
            return
        if mode == "new" and k == "tab":
            listed = self.ctx.listed
            self.new_mux = listed[(listed.index(self.new_mux) + 1) % len(listed)]
            return
        if k in ("enter", "up", "down"):
            value, self.mode, self.input = self.input, None, ""
            if mode == "rename" and self.target and self.target.session:
                if k == "enter":
                    self.rename(self.target.session, value)
            elif mode == "new":
                if k == "enter":
                    self.create(self.new_mux, value)
            elif k != "enter":
                self.list_key(k)
            return
        if k == "backspace":
            self.input = self.input[:-1]
        elif k == "ctrl+u":
            self.input = ""
        elif k == "ctrl+w":
            self.input = re.sub(r"\S*\s*$", "", self.input)
        elif len(k) == 1 and k.isprintable():
            self.input += k
        if mode == "filter":
            self.filter, self.cursor = self.input, [0, 0]

    def mouse(self, button: int, x: int, y: int) -> None:
        if self.mode:
            if self.mode == "help":
                self.mode = None
            return
        if button in (64, 65):
            for h in self.hits:
                if h.index < 0 and h.y0 <= y < h.y1 and h.x0 <= x < h.x1:
                    self.focus = h.which
            n = len(self.items(self.focus))
            d = -1 if button == 64 else 1
            self.cursor[self.focus] = max(0, min(n - 1, self.cursor[self.focus] + d))
            return
        if button == 0:
            for h in self.hits:
                if h.index >= 0 and h.y0 == y and h.x0 <= x < h.x1:
                    again = (
                        self.focus == h.which
                        and self.cursor[h.which] == h.index
                        and not self.just_focused
                    )
                    self.focus, self.cursor[h.which] = h.which, h.index
                    if again:
                        self.list_key("enter")
                    return

    def render(self, cols: int, rows: int) -> list[str]:
        return self.view.render(cols, rows)


# ---------------------------------------------------------------- view


class View:
    """Paints the app's state as exactly rows lines of cols cells, and
    records where the rows are for the mouse."""

    def __init__(self, app: App) -> None:
        self.app = app

    def render(self, cols: int, rows: int) -> list[str]:
        app = self.app
        app.hits = []
        app.clamp()
        dim = 0.55 if app.mode in ("rename", "new", "kill", "help") else 0.0
        Canvas.theme = Theme(app.options.dark, dim)
        Canvas.paint_bg = app.options.paint_bg
        t = Canvas.theme
        sidebar = app.options.sidebar
        min_cols, min_rows = (
            (SIDEBAR_MIN_COLS, SIDEBAR_MIN_ROWS) if sidebar else (MIN_COLS, MIN_ROWS)
        )
        if cols < min_cols or rows < min_rows:
            text = f"Make the window at least {min_cols}×{min_rows}."
            msg = [
                paint(" " * max(0, (cols - len(line)) // 2) + line, t.subtle)
                for line in textwrap.wrap(text, max(1, cols))[:rows]
            ]
            blank = fit("", cols)
            top = (rows - len(msg)) // 2
            body = [fit(line, cols) for line in msg]
            return [blank] * top + body + [blank] * (rows - top - len(msg))

        # A sidebar has no header and no preview.
        top = 0 if sidebar else 1
        h = rows - 1 - top
        wide = cols >= PREVIEW_MIN_COLS and not sidebar
        lw = max(34, min(46, cols * 2 // 5)) if wide else cols
        sh = max(4, (h * 11 + 19) // 20)
        body = self.list_panel(SESSIONS, "Sessions", 0, top, lw, sh)
        body += self.list_panel(AGENTS, "Agents", 0, top + sh, lw, h - sh)
        if wide:
            body = [
                left + right for left, right in zip(body, self.preview(cols - lw, h))
            ]
        header = [] if sidebar else [self.header(cols)]
        lines = header + body + [self.footer(cols)]

        if dim:
            Canvas.theme = Theme(app.options.dark)
            dialog = self.dialog(cols)
            x0 = max(0, (cols - width(dialog[0])) // 2)
            y0 = max(top, (rows - len(dialog)) // 2 - 1)
            for i, d in enumerate(dialog):
                if y0 + i < rows:
                    lines[y0 + i] = overlay(lines[y0 + i], x0, d)
        return lines

    def header(self, cols: int) -> str:
        app, t = self.app, Canvas.theme
        pill = gradient(" ◇ multiplexer dashboard ", t.iris, t.rose, t.base)
        left = pill + paint("  " + app.ctx.label, t.subtle)
        n_s = sum(len(g.sessions) for g in app.groups.values())
        n_a = sum(len(g.agents) for g in app.groups.values())
        right = (
            paint(plural(n_s, "session"), t.text)
            + paint(" · ", t.muted)
            + paint(plural(n_a, "agent") + " ", t.gold)
        )
        return lr(left, right, cols)

    def panel(
        self,
        title: str,
        extra: str,
        note: str,
        body: list[str],
        w: int,
        h: int,
        focused: bool,
    ) -> list[str]:
        t = Canvas.theme
        bc = t.iris if focused else t.hl_high

        def border(s: str) -> str:
            return paint(s, bc)

        if focused:
            chip = paint(f" {title} ", t.base, t.iris, bold=True)
        else:
            chip = paint(f" {title} ", t.subtle, bold=True)
        room = w - 6 - width(chip)
        if extra and width(extra) > room:
            extra = cut(extra, 0, max(0, room - 1)) + paint("…", t.muted)
        top = border("╭─") + chip + extra
        top += border("─" * max(0, w - width(top) - 1) + "╮")
        out = [fit(top, w)]
        for i in range(h - 2):
            out.append(
                border("│") + fit(body[i] if i < len(body) else "", w - 2) + border("│")
            )
        tag = paint(f" {note} ", t.muted) if note else ""
        out.append(
            fit(border("╰" + "─" * max(0, w - 3 - width(tag))) + tag + border("─╯"), w)
        )
        return out

    def list_panel(
        self, which: int, title: str, x: int, y: int, w: int, h: int
    ) -> list[str]:
        app, t = self.app, Canvas.theme
        rows = app.rows(which)
        items = items_of(rows)
        focused = app.focus == which
        sel = items[app.cursor[which]] if items else None
        ih, iw = h - 2, w - 2
        cursor_row = next((i for i, r in enumerate(rows) if r is sel), None)
        start = app.offset[which] = scroll_offset(
            rows, cursor_row, app.offset[which], ih
        )
        app.hits.append(Hit(which, -1, y, y + h, x, x + w))
        body = []
        index = {id(r): i for i, r in enumerate(items)}
        name_w = self.agent_name_width()
        for r in rows[start : start + ih]:
            if r.kind == "group":
                body.append(self.group_row(r, which, iw))
                continue
            is_sel = r is sel
            if is_sel and focused:
                pen = Pen(t.hl_med)
            elif is_sel:
                pen = Pen(t.hl_low)
            else:
                pen = Pen()
            accent = pen("▌", t.iris) if is_sel and focused else pen(" ")
            if r.session:
                line = self.session_row(r.session, iw - 1, pen, is_sel)
            elif r.agent:
                line = self.agent_row(r.agent, iw - 1, pen, is_sel, name_w)
            else:
                line = ""
            app.hits.append(
                Hit(which, index[id(r)], y + 1 + len(body), 0, x + 1, x + 1 + iw)
            )
            body.append(accent + line)
        if not rows:
            if app.filter:
                text = f"  no match for “{app.filter}”"
            elif which == AGENTS and any(g.loading for g in app.groups.values()):
                text = "  loading…"
            else:
                text = "  no agents" if which == AGENTS else "  no sessions"
            body = ["", paint(text, t.muted, italic=True)]
        note = f"{app.cursor[which] + 1}/{len(items)}" if items else ""
        return self.panel(title, "", note, body, w, h, focused)

    def group_row(self, r: Row, which: int, w: int) -> str:
        t = Canvas.theme
        name = paint(" " + r.mux + " ", t.mux(r.mux), bold=True)
        if r.note == "loading…":
            tail = paint(" loading ", t.muted)
        elif r.note:
            tail = paint(f" {r.note} ", t.love)
        elif r.count == 0 and which == SESSIONS:
            tail = paint(" no sessions ", t.muted, italic=True)
        else:
            tail = paint(f" {r.count} ", t.muted)
        room = w - width(name)
        if width(tail) > room:
            tail = fit(tail, room)
        return name + paint("─" * max(0, room - width(tail)), t.hl_med) + tail

    def session_row(self, s: Session, w: int, pen: Pen, is_sel: bool) -> str:
        t = Canvas.theme
        mark = pen("● ", t.love) if s.current else pen("  ")
        if s.exited:
            name = pen(s.name, t.muted, italic=True)
        else:
            name = pen(s.name, t.text, bold=s.current or is_sel)
        left = pen(" ") + mark + name
        if s.attached and not s.current and w >= 40:
            left += pen(" attached", t.muted)
        if s.exited:
            right = pen(f"exited {s.age} ", t.muted, italic=True)
        else:
            agents = self.app.agents_of(s)
            blocked = any(a.status in ALERT_STATUSES for a in agents)
            right = (
                pen(f"◆{len(agents)} ", t.love if blocked else t.gold, bold=blocked)
                if agents
                else ""
            )
            if w >= 32:
                unit = "win" if s.mux == "tmux" else "tab"
                right += pen(f"{plural(s.tabs, unit):<6} ", t.muted)
        return lr(left, right, w, pen)

    def status(self, a: Agent, pen: Pen, wide: bool) -> str:
        t = Canvas.theme
        st = a.status
        glyph = STATUS_ICONS.get(st or "")
        if glyph is None:
            return ""
        bold = st in ALERT_STATUSES
        if st == "working":
            color = t.gold
        elif st in ALERT_STATUSES:
            color = t.love
        elif st == "idle":
            color = t.foam
        elif st == "done":
            color = t.pine
        else:
            color = t.muted
        return pen(f"{glyph} {st} " if wide else f"{glyph} ", color, bold=bold)

    def agent_name_width(self) -> int:
        """The width of the agent name column: the widest name of all
        agents, ignoring the filter so that the column stays put while the
        user types, and at most MAX_AGENT_NAME_WIDTH."""
        names = [a.name for g in self.app.groups.values() for a in g.agents]
        return min(max(map(width, names), default=0), MAX_AGENT_NAME_WIDTH)

    def agent_row(self, a: Agent, w: int, pen: Pen, is_sel: bool, name_w: int) -> str:
        t = Canvas.theme
        c = t.agent(a.name)
        blocked = a.status in ALERT_STATUSES
        # A space always separates the name from the session.
        name = fit(pen(a.name, c, bold=is_sel or blocked), name_w, pen)
        left = (
            pen(" ")
            + pen(agent_icon(a.name) + " ", t.love if blocked else c)
            + name
            + pen(" ")
            + pen(a.session, t.text)
        )
        tab = pen(" › " + a.tab, t.muted)
        # The status keeps its word when the row has room for it, and the
        # tab goes before the session is cut.
        status = self.status(a, pen, True)
        if width(left) + width(tab) + width(status) >= w:
            status = self.status(a, pen, False)
        if width(left) + width(tab) + width(status) <= w:
            left += tab
        return lr(left, status, w, pen)

    def preview(self, w: int, h: int) -> list[str]:
        app, t = self.app, Canvas.theme
        row = app.selected()
        sep = paint(" › ", t.muted)
        extra, note, info = "", "", ""
        screen: list[str] = []
        if row and row.agent:
            a = row.agent
            extra = (
                paint(" " + a.mux, t.mux(a.mux), bold=True)
                + sep
                + paint(a.session, t.text)
                + sep
                + paint(a.tab, t.subtle)
                + " "
            )
            note = "pane " + a.pane
            info = paint(f"{agent_icon(a.name)} {a.name}", t.agent(a.name), bold=True)
            if a.path:
                info += paint(" · " + self.short_path(a.path), t.subtle)
            st = self.status(a, Pen(), True)
            if st:
                info += paint(" · ", t.muted) + st
        elif row and row.session:
            s = row.session
            extra = (
                paint(" " + s.mux, t.mux(s.mux), bold=True)
                + sep
                + paint(s.name, t.text)
                + " "
            )
            if s.exited:
                info = paint(f"exited {s.age} ago", t.muted, italic=True)
                screen = [
                    "",
                    paint("This session has exited.", t.subtle),
                    paint("Enter resurrects it; x deletes it.", t.muted),
                ]
            else:
                unit = "window" if s.mux == "tmux" else "tab"
                parts = [self.short_path(s.path)] if s.path else []
                parts.append(plural(s.tabs, unit))
                if s.created:
                    parts.append("up " + format_age(time.time() - s.created))
                info = paint(" · ", t.muted).join(paint(p, t.subtle) for p in parts)
                note = "focused pane"
        if row and not (row.session and row.session.exited):
            key = item_key(row)
            p = app.previews.get(key)
            if p and p.error:
                screen = ["", paint(p.error, t.love)]
            elif p:
                screen = p.lines
            elif key in app.capturing:
                screen = ["", paint("capturing…", t.muted, italic=True)]
        body: list[str] = []
        if row:
            room = h - 4
            shown = screen[-room:] if room > 0 else []
            body = [" " + info, paint("─" * (w - 2), t.hl_med)]
            body += [" " + raw(cut(line, 0, w - 3)) for line in shown]
        return self.panel("Preview", extra, note, body, w, h, False)

    def short_path(self, path: str) -> str:
        home = self.app.env.get("HOME") or ""
        if home and (path == home or path.startswith(home.rstrip("/") + "/")):
            return "~" + path[len(home.rstrip("/")) :]
        return path

    def footer(self, cols: int) -> str:
        app, t = self.app, Canvas.theme
        if app.mode == "filter":
            left = (
                paint(" / ", t.base, t.gold, bold=True)
                + paint(" " + app.input, t.text)
                + paint(" ", bg=t.text)
                + paint("   enter keep · esc clear", t.muted)
            )
            n = len(app.items(SESSIONS)) + len(app.items(AGENTS))
            return lr(
                left,
                paint(f"{plural(n, 'match').replace('matchs', 'matches')} ", t.muted),
                cols,
            )
        if app.toast:
            text, warn, _ = app.toast
            if warn:
                icon = paint(" ! ", t.base, t.love, bold=True)
            else:
                icon = paint(" → ", t.base, t.pine, bold=True)
            return fit(icon + paint(" " + text, t.love if warn else t.text), cols)
        actions = [
            ("⇥", "lists"),
            ("/", "filter"),
            ("n", "new"),
            ("r", "rename"),
            ("x", "kill"),
        ]
        help_and_out = [("?", "help")]
        if app.stays_open and app.back_command:
            help_and_out.append(("esc", "back"))
        help_and_out.append(("q", "quit"))
        # A narrow sidebar shows only the first keys, so there help and the
        # way out come right after switch, and the help shows the rest.
        if app.options.sidebar:
            keys = [("↵", "switch")] + help_and_out + actions
        else:
            keys = [("↵", "switch")] + actions + help_and_out
        right = paint(f"/{app.filter} ", t.gold, bold=True) if app.filter else ""
        left = ""
        for k, v in keys:
            piece = paint(f" {k} ", t.text, t.overlay, bold=True) + paint(
                f" {v}  ", t.muted
            )
            if width(left) + width(piece) > cols - width(right) - 1:
                break
            left += piece
        return lr(" " + left, right, cols)

    # ------------------------------------------------------------ dialogs

    def dialog(self, cols: int) -> list[str]:
        app, t = self.app, Canvas.theme
        pen = Pen(t.surface)
        # A dialog in a narrow sidebar takes all but one cell on each side.
        dw = min(64, cols - (2 if app.options.sidebar else 4))
        iw = dw - 4
        caret = paint(" ", bg=t.iris)

        def key(k: str, label: str, bg: RGB = t.overlay, fg: RGB = t.text) -> str:
            return (
                pen(" ")
                + paint(f" {k} ", fg, bg, bold=True)
                + pen(f" {label} ", t.subtle)
            )

        def words(text: str, fg: RGB, **kw: Any) -> list[str]:
            return [pen(word, fg, **kw) for word in text.split()]

        def text_field(value: str) -> str:
            v = value[-max(1, iw - 4) :]
            return (
                paint(" " + v, t.text, t.overlay)
                + caret
                + paint(" " * max(0, iw - 2 - width(v)), bg=t.overlay)
            )

        accent = t.iris
        lines: list[str]
        target = app.target.session if app.target else None
        if app.mode == "rename" and target:
            title = "Rename session"
            lines = [
                "",
                pen(target.mux, t.mux(target.mux), bold=True)
                + pen(" › ", t.muted)
                + pen(target.name, t.text),
                "",
                text_field(app.input),
                "",
                *flow([key("enter", "rename"), key("esc", "cancel")], iw),
            ]
        elif app.mode == "new":
            mux = app.new_mux
            directory, automatic = app.new_session_dir(mux)
            title = "New session"
            lines = [
                "",
                pen("in ", t.subtle)
                + pen(mux, t.mux(mux), bold=True)
                + pen("  " + self.short_path(directory), t.muted),
                "",
                text_field(app.input),
                pen(f"empty: {automatic}", t.muted, italic=True),
                "",
            ]
            keys = [key("enter", "create"), key("esc", "cancel")]
            if len(app.ctx.listed) > 1:
                keys.append(key("tab", "multiplexer"))
            lines += flow(keys, iw)
        elif app.mode == "kill" and target:
            accent = t.love
            verb = "Delete" if target.exited else "Kill"
            title = f"{verb} session"
            agents = app.agents_of(target)
            question = (
                [pen(verb, t.text), pen(target.mux, t.mux(target.mux), bold=True)]
                + words("session", t.text)
                + [pen(target.name, t.text, bold=True) + pen("?", t.text)]
            )
            lines = ["", *flow(question, iw, pen(" "))]
            if agents:
                names = ", ".join(a.name for a in agents)
                stop = "stops" if len(agents) == 1 else "stop"
                text = f"Its {plural(len(agents), 'agent')} ({names}) {stop} with it."
                lines += flow(words(text, t.love), iw, pen(" "))
            if target.current:
                lines += flow(
                    words("This is the session you are in.", t.love), iw, pen(" ")
                )
            keys = [key("y", verb.lower(), t.love, t.base), key("n", "cancel")]
            lines += ["", *flow(keys, iw)]
        else:
            title = "Keys"
            rows = [
                ("j k ↑ ↓", "move"),
                ("g G", "first / last (also Home End)"),
                ("alt+j/k", "next / previous multiplexer"),
                ("Tab", "sessions ⇄ agents"),
                ("Enter", "switch to the session or agent"),
                ("/", "filter as you type"),
                ("n", "new session"),
                ("r", "rename session"),
                ("x", "kill session"),
                ("ctrl+l", "refresh and redraw"),
                ("mouse", "click selects, again switches"),
            ]
            if not app.stays_open:
                rows.append(("q Esc", "close"))
            else:
                if app.back_command:
                    rows.append(("Esc", "back to the last pane"))
                rows.append(("q", "quit"))
            lines = [""]
            for k, v in rows:
                # A description too long for the dialog goes on under itself.
                text = textwrap.wrap(v, max(1, iw - 9))
                lines.append(pen(f"{k:<9}", t.iris, bold=True) + pen(text[0], t.text))
                lines += [pen(" " * 9 + more, t.text) for more in text[1:]]
            lines += ["", pen("any key closes this", t.muted, italic=True)]

        def border(s: str) -> str:
            return paint(s, accent, t.surface)

        chip = paint(f" {title} ", t.base, accent, bold=True)
        out = [border("╭─") + chip + border("─" * max(0, dw - 4 - width(chip)) + "─╮")]
        for line in lines:
            out.append(
                border("│") + pen(" ") + fit(line, iw, pen) + pen(" ") + border("│")
            )
        out.append(border("╰" + "─" * (dw - 2) + "╯"))
        return out


# ---------------------------------------------------------------- main


def parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="multiplexer-dashboard",
        description="A fullscreen picker for tmux, zellij and herdr sessions and their coding agents.",
    )
    p.add_argument(
        "--multiplexer",
        choices=["tmux", "zellij", "herdr"],
        help="list only this multiplexer",
    )
    p.add_argument("--client", help="the tmux client to switch (inside tmux)")
    p.add_argument("--dir", help="the directory of new sessions")
    p.add_argument("--theme", choices=["auto", "light", "dark"], default="auto")
    p.add_argument(
        "--no-bg", action="store_true", help="keep the terminal's own background"
    )
    p.add_argument(
        "--sidebar",
        action="store_true",
        help="show only the lists; inside a multiplexer, stay open after a switch",
    )
    # Internal: see zellij_focus_pane.
    p.add_argument("--zellij-focus-pane", nargs=3, help=argparse.SUPPRESS)
    return p.parse_args(argv)


def run_app(app: App, term: Term, inbox: Inbox) -> None:
    app.refresh()
    while app.result is None:
        now = time.monotonic()
        for kind, key, value in inbox.drain():
            app.receive(kind, key, value, now)
        app.tick(now)
        if app.redraw_all:
            app.redraw_all = False
            term.invalidate()
        cols, rows = term.size()
        term.draw(app.render(cols, rows))
        for ev in term.events(app.timeout(time.monotonic())):
            app.handle(ev)
            if app.result is not None:
                break


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(argv)
    if args.zellij_focus_pane:
        return zellij_focus_pane(*args.zellij_focus_pane)
    ctx = detect_context(os.environ, shutil.which, args.multiplexer)
    if not ctx.listed:
        print(
            "multiplexer-dashboard: found none of zellij, herdr, or tmux",
            file=sys.stderr,
        )
        return 1
    inbox = Inbox()
    try:
        term = Term(inbox.read_fd, focus_events=args.sidebar)
    except OSError as e:
        print(
            f"multiplexer-dashboard: cannot open the terminal: {e.strerror}",
            file=sys.stderr,
        )
        return 1

    def on_resize(*_: object) -> None:
        term.resized = True
        inbox.wake()

    def on_exit(signum: int, _frame: object) -> None:
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGWINCH, on_resize)
    signal.signal(signal.SIGTERM, on_exit)
    signal.signal(signal.SIGHUP, on_exit)
    try:
        with term:
            dark = {"light": False, "dark": True}.get(args.theme)
            if dark is None:
                dark = term.background_is_dark() is not False
            options = Options(args.client, args.dir, dark, not args.no_bg, args.sidebar)
            app = App(ctx, options, run_command, os.environ, inbox)
            run_app(app, term, inbox)
    except KeyboardInterrupt:
        return 130
    result = app.result or Exit(0)
    plan = result.plan
    if plan and plan.attach:
        try:
            if plan.cwd:
                os.chdir(plan.cwd)
            if plan.helper:
                subprocess.Popen(
                    plan.helper,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            sys.stdout.flush()
            os.execvp(plan.attach[0], plan.attach)
        except OSError as e:
            print(
                f"multiplexer-dashboard: {plan.attach[0]}: {e.strerror}",
                file=sys.stderr,
            )
            return 1
    return result.code


if __name__ == "__main__":
    sys.exit(main())
