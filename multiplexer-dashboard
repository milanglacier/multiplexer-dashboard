def agent_icon(name: str) -> str:
    return AGENT_ICONS.get(name, CUSTOM_AGENT_ICON)


def agent_names(env: Mapping[str, str]) -> frozenset[str]:
    extra = env.get("MULTIPLEXER_DASHBOARD_AGENTS", "")
    return frozenset(DEFAULT_AGENTS) | {
        n.strip() for n in extra.split(",") if n.strip()
    }


def is_interpreter(program: str) -> bool:
    return bool(INTERPRETER_RE.fullmatch(program))


def detect_agent(argv: Sequence[str], names: frozenset[str]) -> str | None:
    """The agent that a command line runs, or None. For an interpreter, the
    agent is the basename of the first argument that is not an option."""
    if not argv:
        return None
    # A login shell's name starts with "-".
    program = os.path.basename(argv[0]).lstrip("-")
    if program in names:
        return program
    if is_interpreter(program):
        for arg in argv[1:]:
            if arg.startswith("-"):
                continue
            base = SCRIPT_EXT_RE.sub("", os.path.basename(arg))
            return base if base in names else None
    return None


class ProcessTree:
    """A snapshot of `ps -A -o pid=,ppid=,args=`."""

    def __init__(self, text: str) -> None:
        self.args: dict[int, list[str]] = {}
        self.children: dict[int, list[int]] = {}
        for line in text.splitlines():
            parts = line.split(None, 2)
            if len(parts) < 2 or not parts[0].isdigit() or not parts[1].isdigit():
                continue
            pid, ppid = int(parts[0]), int(parts[1])
            self.args[pid] = parts[2].split() if len(parts) > 2 else []
            self.children.setdefault(ppid, []).append(pid)

    def agent_under(self, pid: int, names: frozenset[str]) -> str | None:
        """The agent of the deepest process at or below pid that runs one."""
        best: tuple[int, str | None] = (-1, None)
        stack = [(pid, 0)]
        seen: set[int] = set()
        while stack:
            p, depth = stack.pop()
            if p in seen:
                continue
            seen.add(p)
            name = detect_agent(self.args.get(p, []), names)
            if name and depth > best[0]:
                best = (depth, name)
            stack.extend((c, depth + 1) for c in self.children.get(p, []))
        return best[1]


# ---------------------------------------------------------------- tmux

TMUX_SESSION_FORMAT = (
    "#{session_name}\t#{session_id}\t#{session_created}\t#{session_windows}\t"
    "#{session_attached}\t#{session_path}"
)
TMUX_PANE_FORMAT = (
    "#{session_id}\t#{window_index}\t#{window_name}\t#{window_active}\t"
    "#{pane_active}\t#{pane_last}\t#{pane_id}\t#{pane_current_command}\t"
    "#{pane_pid}\t#{pane_current_path}"
)


class TmuxPane(NamedTuple):
    session_id: str
    window_index: int
    window_name: str
    window_active: bool
    pane_active: bool
    pane_last: bool
    pane_id: str
    command: str
    pid: int
    path: str


def to_int(s: str, default: int = 0) -> int:
    try:
        return int(s)
    except ValueError:
        return default


def parse_tmux_sessions(text: str) -> list[Session]:
    """Sessions from `list-sessions -F TMUX_SESSION_FORMAT`, in creation
    order."""
    sessions = []
    for line in text.splitlines():
        f = line.split("\t")
        if len(f) != 6:
            continue
        sessions.append(
            Session(
                "tmux",
                f[0],
                id=f[1],
                created=float(to_int(f[2])),
                tabs=to_int(f[3]),
                attached=to_int(f[4]) > 0,
                path=f[5],
            )
        )
    sessions.sort(key=lambda s: (s.created or 0, to_int(s.id.lstrip("$"))))
    return sessions


def parse_tmux_panes(text: str) -> list[TmuxPane]:
    """Panes from `list-panes -a -F TMUX_PANE_FORMAT`."""
    panes = []
    for line in text.splitlines():
        f = line.split("\t")
        if len(f) != 10:
            continue
        panes.append(
            TmuxPane(
                f[0],
                to_int(f[1]),
                f[2],
                f[3] == "1",
                f[4] == "1",
                f[5] == "1",
                f[6],
                f[7],
                to_int(f[8]),
                f[9],
            )
        )
    return panes


def tmux_snapshot(
    sessions: list[Session],
    panes: list[TmuxPane],
    procs: ProcessTree | None,
    names: frozenset[str],
    current_id: str | None,
    own_pane: str = "",
) -> Group:
    """Joins the sessions and panes: each session gets its focused pane and
    that pane's directory, and each agent pane becomes an agent. When the
    dashboard's own pane (own_pane) is the focused one, the pane that was
    focused before it counts instead."""
    by_id = {s.id: s for s in sessions}
    order = {s.id: i for i, s in enumerate(sessions)}
    for s in sessions:
        s.current = s.id == current_id
        window = [
            p
            for p in panes
            if p.session_id == s.id and p.window_active and p.pane_id != own_pane
        ]
        focused = (
            next((p for p in window if p.pane_active), None)
            or next((p for p in window if p.pane_last), None)
            or (window[0] if window else None)
        )
        if focused:
            s.pane, s.path = focused.pane_id, focused.path or s.path
    agents = []
    for p in panes:
        s = by_id.get(p.session_id)
        if not s:
            continue
        name = p.command if p.command in names else None
        if not name and procs and is_interpreter(p.command):
            name = procs.agent_under(p.pid, names)
        if name:
            agents.append(
                Agent(
                    "tmux",
                    s.name,
                    s.id,
                    p.window_name,
                    p.window_index,
                    p.pane_id,
                    name,
                    p.path,
                )
            )
    agents.sort(
        key=lambda a: (order[a.session_key], a.tab_index, to_int(a.pane.lstrip("%")))
    )
    return Group("tmux", sessions, agents)


def parse_tmux_visible(text: str) -> bool | None:
    """Whether a pane is on screen, from `display-message -p -t PANE
    '#{window_active} #{session_attached}'`: its window is the session's
    active one and a client shows the session. None when the reply holds no
    answer."""
    f = text.split()
    if len(f) != 2:
        return None
    return f[0] != "0" and f[1] != "0"


class Tmux:
    name = "tmux"
    checks_visibility = True

    def __init__(
        self, runner: Runner, env: Mapping[str, str], client: str | None = None
    ) -> None:
        self.run = runner
        self.env = env
        self.client = client
        self.names = agent_names(env)

    def client_args(self) -> list[str]:
        return ["-c", self.client] if self.client else []

    def load(self, inside: bool) -> Group:
        r = self.run(["tmux", "list-sessions", "-F", TMUX_SESSION_FORMAT])
        if r.code != 0:
            msg = error_text(r)
            if "no server running" in msg or "error connecting to" in msg:
                return Group("tmux")
            return Group("tmux", error=msg)
        sessions = parse_tmux_sessions(r.out)
        p = self.run(["tmux", "list-panes", "-a", "-F", TMUX_PANE_FORMAT])
        panes = parse_tmux_panes(p.out) if p.code == 0 else []
        procs = None
        if any(is_interpreter(pane.command) for pane in panes):
            ps = self.run(["ps", "-A", "-o", "pid=,ppid=,args="])
            procs = ProcessTree(ps.out) if ps.code == 0 else None
        current = self.current_session() if inside else None
        own = self.env.get("TMUX_PANE", "") if inside else ""
        return tmux_snapshot(sessions, panes, procs, self.names, current, own)

    def current_session(self) -> str | None:
        # display-message -c still formats the calling pane's session.
        if self.client:
            r = self.run(
                ["tmux", "list-clients", "-F", "#{client_name}\t#{session_id}"]
            )
            for line in r.out.splitlines():
                name, _, sid = line.partition("\t")
                if name == self.client:
                    return sid
            return None
        r = self.run(["tmux", "display-message", "-p", "#{session_id}"])
        return r.out.strip() if r.code == 0 else None

    def switch_session(self, s: Session, inside: bool) -> Plan:
        # The session id, since tmux reads ":" and "." in a name as window
        # and pane separators.
        if inside:
            return Plan([["tmux", "switch-client", *self.client_args(), "-t", s.id]])
        return Plan(attach=["tmux", "attach-session", "-t", s.id])

    def switch_agent(self, a: Agent, inside: bool, current: str | None) -> Plan:
        # A pane target also selects the pane's window and the pane.
        if inside:
            return Plan([["tmux", "switch-client", *self.client_args(), "-t", a.pane]])
        return Plan(attach=["tmux", "attach-session", "-t", a.pane])

    def create(self, name: str, directory: str, inside: bool) -> Plan:
        if inside:
            return Plan(
                [
                    ["tmux", "new-session", "-d", "-s", name, "-c", directory],
                    ["tmux", "switch-client", *self.client_args(), "-t", "=" + name],
                ]
            )
        return Plan(attach=["tmux", "new-session", "-s", name, "-c", directory])

    def rename(self, s: Session, new: str) -> Plan:
        return Plan([["tmux", "rename-session", "-t", s.id, new]])

    def kill(self, s: Session) -> Plan:
        return Plan([["tmux", "kill-session", "-t", s.id]])

    def capture(self, pane: str, s: Session | None) -> Result:
        return self.run(["tmux", "capture-pane", "-e", "-p", "-t", pane])

    def default_dir(self, inside: bool) -> str | None:
        return None

    def back(self) -> list[str] | None:
        """The command that gives focus back to the last pane of the
        dashboard's own window."""
        pane = self.env.get("TMUX_PANE")
        return ["tmux", "last-pane"] + (["-t", pane] if pane else [])

    def visible(self) -> bool | None:
        """Whether the dashboard's own pane is on screen, or None when tmux
        does not say."""
        pane = self.env.get("TMUX_PANE")
        if not pane:
            return None
        r = self.run(
            [
                "tmux",
                "display-message",
                "-p",
                "-t",
                pane,
                "#{window_active} #{session_attached}",
            ]
        )
        return parse_tmux_visible(r.out) if r.code == 0 else None


# ---------------------------------------------------------------- zellij

ZELLIJ_SESSION_RE = re.compile(
    r"^(?P<name>.+?) \[Created (?P<age>.*?) ago\](?P<rest>.*)$"
)
DURATION_RE = re.compile(r"(\d+)\s*([a-zA-Z]+)")


def parse_duration(text: str) -> float:
    """Seconds in a duration as zellij prints it, such as "2days 3h 4m 5s"."""
    total = 0.0
    for n, unit in DURATION_RE.findall(text):
        u = unit.lower()
        if u in ("ms", "us", "ns", "µs"):
            continue
        if u.startswith("y"):
            scale = 365.25 * 86400
        elif u.startswith("mo") or u == "mon":
            scale = 30.44 * 86400
        elif u.startswith("w"):
            scale = 7 * 86400
        elif u.startswith("d"):
            scale = 86400
        elif u.startswith("h"):
            scale = 3600
        elif u.startswith("m"):
            scale = 60
        else:
            scale = 1
        total += int(n) * scale
    return total


def parse_zellij_sessions(text: str, now: float) -> list[Session]:
    """Sessions from `list-sessions --no-formatting`: running sessions in
    creation order, then the exited ones that zellij can resurrect. zellij
    prints ages in whole seconds, so sessions created in the same second
    come in no fixed order."""
    running, exited = [], []
    for line in text.splitlines():
        m = ZELLIJ_SESSION_RE.match(line.strip())
        if not m:
            continue
        rest, age = m["rest"], parse_duration(m["age"])
        if "EXITED" in rest:
            exited.append(
                Session("zellij", m["name"], exited=True, age=format_age(age))
            )
        else:
            running.append(
                Session(
                    "zellij", m["name"], created=now - age, current="(current)" in rest
                )
            )
    running.sort(key=lambda s: s.created or 0)
    return running + exited


def parse_zellij_panes(
    s: Session,
    panes_json: str,
    tabs_json: str | None,
    names: frozenset[str],
    own_pane: str = "",
) -> list[Agent]:
    """Fills in a session's tab count, focused pane and directory from
    `action list-panes -a -j` and `action list-tabs -j -s`, and returns its
    agents. The focused pane is one of the active tab's, a tiled one before
    a floating one, and never the dashboard's own pane (own_pane)."""
    panes = json.loads(panes_json)
    tabs: list[dict[str, Any]] = []
    if tabs_json:
        try:
            tabs = json.loads(tabs_json)
        except ValueError:
            tabs = []
    terminals = [p for p in panes if not p.get("is_plugin") and not p.get("exited")]
    # A background session can have tabs without panes.
    s.tabs = len(tabs) or len({p.get("tab_id") for p in panes})
    active = next((t.get("tab_id") for t in tabs if t.get("active")), None)
    if active is None:
        positions = sorted(
            ((p.get("tab_position", 0), p.get("tab_id")) for p in terminals),
            key=lambda x: x[0],
        )
        active = positions[0][1] if positions else None
    in_tab = [
        p
        for p in terminals
        if p.get("tab_id") == active and f"terminal_{p['id']}" != own_pane
    ]
    in_tab.sort(key=lambda p: (not p.get("is_focused"), bool(p.get("is_floating"))))
    focused = in_tab[0] if in_tab else None
    if focused:
        s.pane = f"terminal_{focused['id']}"
        s.path = focused.get("pane_cwd") or ""
    agents = []
    for p in terminals:
        command = p.get("pane_command") or p.get("terminal_command") or ""
        name = detect_agent(command.split(), names)
        if name:
            agents.append(
                Agent(
                    "zellij",
                    s.name,
                    s.name,
                    p.get("tab_name") or "",
                    int(p.get("tab_position") or 0),
                    f"terminal_{p['id']}",
                    name,
                    p.get("pane_cwd") or "",
                    zellij_status(p),
                    tab_id=str(p.get("tab_id", "")),
                )
            )
    agents.sort(key=lambda a: (a.tab_index, to_int(a.pane.split("_")[-1])))
    return agents


def zellij_status(pane: dict[str, Any]) -> str | None:
    """The status that the program in a zellij pane reports with OSC 7501,
    such as "working". Zellij lists it in `program_status`, where the record
    without an id is the program's own status and the others are its
    subtasks. Zellij before 0.46 lists no status."""
    for record in pane.get("program_status") or []:
        if record.get("id") is None and record.get("state"):
            return str(record["state"]).lower()
    return None


def zellij_pane_tabs(panes_json: str) -> dict[str, str]:
    """The tab id of each pane, named as list-clients names it, such as
    "terminal_3" or "plugin_1", from `action list-panes -a -j`."""
    tabs = {}
    for p in json.loads(panes_json):
        kind = "plugin" if p.get("is_plugin") else "terminal"
        tabs[f"{kind}_{p['id']}"] = str(p.get("tab_id", ""))
    return tabs


def zellij_pane_visible(
    clients: Sequence[tuple[str, str]], pane_tabs: Mapping[str, str], own_pane: str
) -> bool:
    """Whether a client shows the tab of the dashboard's own pane: one of the
    clients' focused panes is in that tab. A pane missing from pane_tabs,
    which was made after the map, counts as in the tab, so that the next
    full load brings the map up to date."""
    own_tab = pane_tabs.get(own_pane)
    if own_tab is None:
        return True
    return any(pane_tabs.get(pane, own_tab) == own_tab for _, pane in clients)


def parse_zellij_clients(text: str) -> list[tuple[str, str]]:
    """Client ids and their focused panes from `action list-clients`."""
    clients = []
    for line in text.splitlines()[1:]:
        f = line.split()
        if len(f) >= 2:
            clients.append((f[0], f[1]))
    return clients


def zellij_focus_pane(
    session: str, tab_id: str, pane: str, runner: Runner = run_command
) -> int:
    """Waits up to 10 seconds for a client to attach to a session that had
    none, then moves it to a pane. This runs in the background while an
    attaching client replaces the dashboard. zellij's focus-pane-id does not
    move a client when it comes from outside the session, but
    go-to-tab-by-id and focus-next-pane move the session's first client."""
    base = ["zellij", "--session", session, "action"]

    def clients() -> list[tuple[str, str]]:
        r = runner(base + ["list-clients"])
        return parse_zellij_clients(r.out) if r.code == 0 else []

    deadline = time.monotonic() + 10
    while not clients():
        if time.monotonic() > deadline:
            return 1
        time.sleep(0.1)
    if tab_id:
        runner(base + ["go-to-tab-by-id", tab_id])
    for _ in range(64):
        if any(p == pane for _, p in clients()):
            return 0
        runner(base + ["focus-next-pane"])
    return 1


class Zellij:
    name = "zellij"
    checks_visibility = True

    def __init__(
        self, runner: Runner, env: Mapping[str, str], client: str | None = None
    ) -> None:
        self.run = runner
        self.env = env
        self.names = agent_names(env)
        self.own_pane = f"terminal_{env.get('ZELLIJ_PANE_ID')}"
        # The tab of each pane of the current session, from the last load.
        self.pane_tabs: dict[str, str] = {}

    def load(self, inside: bool) -> Group:
        r = self.run(["zellij", "list-sessions", "--no-formatting"])
        if r.code != 0:
            if "No active zellij sessions" in r.out + r.err:
                return Group("zellij")
            return Group("zellij", error=error_text(r))
        sessions = parse_zellij_sessions(r.out, time.time())
        current = self.env.get("ZELLIJ_SESSION_NAME") if inside else None
        own = self.own_pane if inside else ""
        for s in sessions:
            s.current = (s.current and inside) or s.name == current
        running = [s for s in sessions if not s.exited]

        def details(s: Session) -> tuple[Result, Result]:
            base = ["zellij", "--session", s.name, "action"]
            return self.run(base + ["list-panes", "-a", "-j"]), self.run(
                base + ["list-tabs", "-j", "-s"]
            )

        agents: list[Agent] = []
        for s, (panes, tabs) in zip(
            running, run_parallel([lambda s=s: details(s) for s in running])
        ):
            if panes.code != 0:
                continue
            try:
                tabs_json = tabs.out if tabs.code == 0 else None
                own_pane = own if s.current else ""
                agents += parse_zellij_panes(
                    s, panes.out, tabs_json, self.names, own_pane
                )
                if own_pane:
                    self.pane_tabs = zellij_pane_tabs(panes.out)
            except (ValueError, KeyError, TypeError):
                continue
        return Group("zellij", sessions, agents)

    def has_clients(self, session: str) -> bool:
        r = self.run(["zellij", "--session", session, "action", "list-clients"])
        return r.code == 0 and bool(parse_zellij_clients(r.out))

    def switch_session(self, s: Session, inside: bool) -> Plan:
        if inside:
            return Plan([["zellij", "action", "switch-session", s.name]])
        return Plan(attach=["zellij", "attach", s.name])

    def switch_agent(self, a: Agent, inside: bool, current: str | None) -> Plan:
        if not inside:
            helper = [sys.executable, SCRIPT, "--zellij-focus-pane"]
            return Plan(
                attach=["zellij", "attach", a.session],
                helper=helper + [a.session, a.tab_id, a.pane],
            )
        if a.session == current:
            return Plan([["zellij", "action", "focus-pane-id", a.pane]])
        return Plan(
            [["zellij", "action", "switch-session", a.session, "--pane-id", a.pane]]
        )

    def create(self, name: str, directory: str, inside: bool) -> Plan:
        if inside:
            return Plan(
                [["zellij", "action", "switch-session", name, "--cwd", directory]]
            )
        return Plan(attach=["zellij", "--session", name], cwd=directory)

    def rename(self, s: Session, new: str) -> Plan:
        return Plan([["zellij", "--session", s.name, "action", "rename-session", new]])

    def kill(self, s: Session) -> Plan:
        return Plan(
            [["zellij", "delete-session" if s.exited else "kill-session", s.name]]
        )

    def capture(self, pane: str, s: Session | None) -> Result:
        session = s.name if s else ""
        return self.run(
            [
                "zellij",
                "--session",
                session,
                "action",
                "dump-screen",
                "--ansi",
                "--pane-id",
                pane,
            ]
        )

    def default_dir(self, inside: bool) -> str | None:
        return None

    def back(self) -> list[str] | None:
        """The command that gives focus back to the last focused pane."""
        return ["zellij", "action", "focus-last-pane"]

    def visible(self) -> bool | None:
        """Whether a client of the current session shows the tab of the
        dashboard's own pane, or None when zellij does not say."""
        r = self.run(["zellij", "action", "list-clients"])
        if r.code != 0:
            return None
        return zellij_pane_visible(
            parse_zellij_clients(r.out), self.pane_tabs, self.own_pane
        )


# ---------------------------------------------------------------- herdr


def herdr_result(text: str) -> dict[str, Any]:
    data = json.loads(text)
    result = data.get("result") if isinstance(data, dict) else None
    return result if isinstance(result, dict) else {}


def parse_herdr(
    workspaces_json: str,
    tabs_json: str | None,
    panes_json: str | None,
    agents_json: str | None,
    inside: bool,
) -> Group:
    """Workspaces as sessions, in workspace number order, and herdr's agents
    with their status, from the JSON of `workspace list`, `tab list`, `pane
    list` and `agent list`."""
    workspaces = herdr_result(workspaces_json).get("workspaces") or []
    tabs = herdr_result(tabs_json).get("tabs") or [] if tabs_json else []
    panes = herdr_result(panes_json).get("panes") or [] if panes_json else []
    raw_agents = herdr_result(agents_json).get("agents") or [] if agents_json else []
    tab_by_id = {t.get("tab_id"): t for t in tabs}
    sessions = []
    for w in sorted(workspaces, key=lambda w: w.get("number") or 0):
        s = Session(
            "herdr",
            str(w.get("label") or w.get("workspace_id")),
            id=str(w.get("workspace_id")),
            tabs=int(w.get("tab_count") or 0),
            current=inside and bool(w.get("focused")),
        )
        in_tab = [p for p in panes if p.get("tab_id") == w.get("active_tab_id")]
        pane = next(
            (p for p in in_tab if p.get("focused")), in_tab[0] if in_tab else None
        )
        if pane:
            s.pane = str(pane.get("pane_id"))
            s.path = str(pane.get("foreground_cwd") or pane.get("cwd") or "")
        sessions.append(s)
    by_id = {s.id: s for s in sessions}
    order = {s.id: i for i, s in enumerate(sessions)}
    agents = []
    for a in raw_agents:
        s = by_id.get(a.get("workspace_id"))
        if not s or not a.get("agent"):
            continue
        tab = tab_by_id.get(a.get("tab_id")) or {}
        agents.append(
            Agent(
                "herdr",
                s.name,
                s.id,
                str(tab.get("label") or tab.get("number") or ""),
                int(tab.get("number") or 0),
                str(a.get("pane_id")),
                str(a.get("agent")),
                str(a.get("foreground_cwd") or a.get("cwd") or ""),
                a.get("agent_status"),
                tab_id=str(a.get("tab_id") or ""),
            )
        )
    agents.sort(
        key=lambda a: (
            order[a.session_key],
            a.tab_index,
            to_int(a.pane.rpartition(":p")[2]),
        )
    )
    return Group("herdr", sessions, agents)


class Herdr:
    name = "herdr"
    checks_visibility = False

    def __init__(
        self, runner: Runner, env: Mapping[str, str], client: str | None = None
    ) -> None:
        self.run = runner
        self.env = env

    def load(self, inside: bool) -> Group:
        r = self.run(["herdr", "workspace", "list"])
        if r.code != 0:
            return Group("herdr", error=error_text(r))
        tabs, panes, agents = run_parallel(
            [
                lambda: self.run(["herdr", "tab", "list"]),
                lambda: self.run(["herdr", "pane", "list"]),
                lambda: self.run(["herdr", "agent", "list"]),
            ]
        )

        def ok(x: Result) -> str | None:
            return x.out if x.code == 0 else None

        try:
            return parse_herdr(r.out, ok(tabs), ok(panes), ok(agents), inside)
        except (ValueError, TypeError, AttributeError) as e:
            return Group("herdr", error=f"unexpected answer: {e}")

    def server_running(self) -> bool:
        return self.run(["herdr", "workspace", "list"]).code == 0

    def start_server(self) -> str | None:
        """Starts the default herdr server in the background when none runs,
        and waits up to 5 seconds for it to answer. Returns an error."""
        if self.server_running():
            return None
        try:
            subprocess.Popen(
                ["herdr", "server"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as e:
            return f"herdr: {e.strerror}"
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            if self.server_running():
                return None
            time.sleep(0.1)
        return "the herdr server did not start"

    def switch_session(self, s: Session, inside: bool) -> Plan:
        return Plan(
            [["herdr", "workspace", "focus", s.id]],
            attach=None if inside else ["herdr"],
        )

    def switch_agent(self, a: Agent, inside: bool, current: str | None) -> Plan:
        return Plan(
            [["herdr", "agent", "focus", a.pane]], attach=None if inside else ["herdr"]
        )

    def create(self, name: str, directory: str, inside: bool) -> Plan:
        return Plan(
            [
                [
                    "herdr",
                    "workspace",
                    "create",
                    "--cwd",
                    directory,
                    "--label",
                    name,
                    "--focus",
                ]
            ],
            attach=None if inside else ["herdr"],
        )

    def rename(self, s: Session, new: str) -> Plan:
        return Plan([["herdr", "workspace", "rename", s.id, new]])

    def kill(self, s: Session) -> Plan:
        return Plan([["herdr", "workspace", "close", s.id]])

    def capture(self, pane: str, s: Session | None) -> Result:
        if s is not None:
            # The session's pane is one of its active tab; ask for the tab's
            # focused pane.
            r = self.run(["herdr", "pane", "layout", "--pane", pane])
            if r.code == 0:
                try:
                    pane = str(herdr_result(r.out)["layout"]["focused_pane_id"] or pane)
                except (ValueError, KeyError, TypeError):
                    pass
        return self.run(
            ["herdr", "pane", "read", pane, "--source", "visible", "--format", "ansi"]
        )

    def default_dir(self, inside: bool) -> str | None:
        """Inside herdr, the directory of the current pane."""
        if not inside or not self.env.get("HERDR_PANE_ID"):
            return None
        r = self.run(["herdr", "pane", "current", "--current"])
        if r.code != 0:
            return None
        try:
            pane = herdr_result(r.out).get("pane") or {}
        except ValueError:
            return None
        return pane.get("foreground_cwd") or pane.get("cwd") or None

    def back(self) -> list[str] | None:
        """None: herdr's CLI has no command that focuses the last pane."""
        return None

    def visible(self) -> bool | None:
        """None: the dashboard does not ask herdr, and its pane counts as on
        screen."""
        return None


BACKENDS = {"tmux": Tmux, "zellij": Zellij, "herdr": Herdr}

# ---------------------------------------------------------------- naming


def sanitize_name(name: str) -> str:
    """Replaces each character other than a letter, a digit, "_", "-" or "~"
    with "-"."""
    return "".join(c if c.isalnum() or c in "_-~" else "-" for c in name)


def dir_label(directory: str, home: str, git_root: str | None) -> str:
    """The automatic session name for a directory: "~" for the home
    directory, the repository's root directory name inside a git repository,
    and the directory name otherwise."""
    if os.path.normpath(directory) == os.path.normpath(home):
        return "~"
    root = os.path.normpath(git_root or directory)
    return os.path.basename(root) or root


def git_root(runner: Runner, directory: str) -> str | None:
    r = runner(["git", "-C", directory, "rev-parse", "--show-toplevel"])
    return r.out.strip() or None if r.code == 0 else None


# ---------------------------------------------------------------- context


@dataclass
class Context:
    """The listed multiplexers, in display order, and the ones the dashboard
    runs inside."""

    listed: list[str]
    inside: set[str]

    @property
    def label(self) -> str:
        if not self.inside:
            return "outside any multiplexer"
        return "in " + " and ".join(m for m in MULTIPLEXERS if m in self.inside)


def detected_multiplexers(env: Mapping[str, str]) -> set[str]:
    found = set()
    if env.get("TMUX"):
        found.add("tmux")
    if env.get("ZELLIJ"):
        found.add("zellij")
    if env.get("HERDR_ENV") == "1":
        found.add("herdr")
    return found


def detect_context(
    env: Mapping[str, str], installed: Callable[[str], Any], only: str | None = None
) -> Context:
    """Inside multiplexers, the listed ones are those; outside, every
    installed one. --multiplexer (only) limits the list to one."""
    inside = detected_multiplexers(env)
    if only:
        return Context([only], inside & {only})
    if inside:
        return Context([m for m in MULTIPLEXERS if m in inside], inside)
    return Context([m for m in MULTIPLEXERS if installed(m)], set())


# ---------------------------------------------------------------- rows


@dataclass
class Row:
    kind: str  # "group", "session" or "agent"
    mux: str
    session: Session | None = None
    agent: Agent | None = None
    count: int = 0
    note: str = ""


def item_key(row: Row) -> tuple[str, ...]:
    if row.session:
        return ("session", row.mux, row.session.key)
    if row.agent:
        return ("agent", row.mux, row.agent.session_key, row.agent.pane)
    return ("group", row.mux)


def build_rows(groups: Sequence[Group], which: int, query: str) -> list[Row]:
    """The rows of a list: a header per multiplexer, then its matching
    items. Without a filter, the sessions list shows every multiplexer's
    header, so that a loading, failing or empty one is still visible."""
    q = query.lower()
    rows: list[Row] = []
    for g in groups:
        items: list[Row]
        if which == SESSIONS:
            items = [
                Row("session", g.mux, session=s)
                for s in g.sessions
                if q in s.name.lower()
            ]
        else:
            items = [
                Row("agent", g.mux, agent=a)
                for a in g.agents
                if not q or any(q in f.lower() for f in (a.name, a.session, a.tab))
            ]
        if items or (which == SESSIONS and not q):
            note = "loading…" if g.loading else g.error or ""
            rows.append(Row("group", g.mux, count=len(items), note=note))
            rows += items
    return rows


def items_of(rows: Sequence[Row]) -> list[Row]:
    return [r for r in rows if r.kind != "group"]


def scroll_offset(
    rows: Sequence[Row], cursor_row: int | None, offset: int, height: int
) -> int:
    """The first visible row. It changes only when the cursor would leave
    the view, and shows a group's header above its first item."""
    if cursor_row is not None:
        top = (
            cursor_row - 1
            if cursor_row > 0 and rows[cursor_row - 1].kind == "group"
            else cursor_row
        )
        if top < offset:
            offset = top
        elif cursor_row >= offset + height:
            offset = cursor_row - height + 1
    return max(0, min(offset, len(rows) - height))


def jump_group(items: Sequence[Row], cursor: int, direction: int) -> int:
    """The first item of the next or previous multiplexer, wrapping around."""
    if not items:
        return 0
    firsts = [i for i, r in enumerate(items) if i == 0 or items[i - 1].mux != r.mux]
    if direction > 0:
        later = [i for i in firsts if i > cursor]
        return later[0] if later else firsts[0]
    earlier = [i for i in firsts if i < cursor]
    return earlier[-1] if earlier else firsts[-1]


